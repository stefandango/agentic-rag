{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/block-force-push-main.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path // empty'); if [[ \"$FILE\" == *.cs ]]; then (cd \"$CLAUDE_PROJECT_DIR\" && dotnet format --include \"$FILE\" >/dev/null 2>&1); fi; exit 0"
          }
        ]
      }
    ]
  }
}
